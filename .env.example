PCB_AOI_APPLICATION_NAME=pcb-aoi-api
PCB_AOI_APPLICATION_VERSION=0.1.0
PCB_AOI_ENVIRONMENT=development
PCB_AOI_API_PREFIX=/api/v1
PCB_AOI_DEBUG=false
PCB_AOI_LOG_LEVEL=INFO
PCB_AOI_LOG_FORMAT=plain
PCB_AOI_RUNTIME_ROOT=runtime
PCB_AOI_DATABASE_FILENAME=pcb_aoi.sqlite3
PCB_AOI_SQLITE_BUSY_TIMEOUT_MS=5000
PCB_AOI_DATABASE_ECHO=false
PCB_AOI_MAX_RGB_BYTES=52428800
PCB_AOI_MAX_HEIGHT_BYTES=268435456
PCB_AOI_MAX_MASK_BYTES=67108864
PCB_AOI_MAX_CALIBRATION_BYTES=5242880
PCB_AOI_MAX_GENERATED_ARTIFACT_BYTES=52428800
# Development-only synthetic processing API. Keep disabled outside trusted fixture work.
PCB_AOI_ENABLE_SYNTHETIC_PROCESSING_API=false
# Required when the synthetic processing API is enabled; relative paths use the repository root.
PCB_AOI_SYNTHETIC_FIXTURE_ROOT=

# Frontend-safe public configuration. Empty uses same-origin /api requests and
# the Vite development proxy. Vite variables are public; never put secrets here.
VITE_API_BASE_URL=
