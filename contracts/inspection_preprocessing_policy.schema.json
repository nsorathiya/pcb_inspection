{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi-for-pcb.local/contracts/inspection-preprocessing-policy/1.0",
  "title": "PCB AOI Inspection Preprocessing Policy",
  "description": "Versioned policy surface for future separate RGB and height preprocessing. Enumeration membership does not imply implementation support.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "policy_id", "policy_version", "name", "description", "development_only", "production_approved", "prerequisites", "rgb", "height", "registration", "output", "safety"],
  "properties": {
    "contract_version": {"const": "pcb-aoi-inspection-preprocessing-policy/1.0"},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_version": {"$ref": "#/$defs/version"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "development_only": {"type": "boolean"},
    "production_approved": {"type": "boolean"},
    "prerequisites": {"$ref": "#/$defs/prerequisites"},
    "rgb": {"$ref": "#/$defs/rgb_policy"},
    "height": {"$ref": "#/$defs/height_policy"},
    "registration": {"$ref": "#/$defs/registration_policy"},
    "output": {"$ref": "#/$defs/output_policy"},
    "safety": {"$ref": "#/$defs/safety_policy"}
  },
  "allOf": [
    {"if": {"properties": {"development_only": {"const": true}}}, "then": {"properties": {"production_approved": {"const": false}}}},
    {"if": {"properties": {"production_approved": {"const": true}}}, "then": {"properties": {"development_only": {"const": false}, "registration": {"properties": {"allow_synthetic_identity_transform": {"const": false}}}}}},
    {"if": {"properties": {"registration": {"properties": {"registration_mode": {"const": "SYNTHETIC_IDENTITY_ONLY"}}, "required": ["registration_mode"]}}}, "then": {"properties": {"development_only": {"const": true}}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "positive_integer": {"type": "integer", "minimum": 1},
    "nullable_positive_integer": {"type": ["integer", "null"], "minimum": 1},
    "roi_mode": {"enum": ["FULL_FRAME", "STATIC_RECTANGLE", "RECIPE_DEFINED"]},
    "resize_mode": {"enum": ["NONE", "RESIZE", "LETTERBOX", "CENTER_CROP"]},
    "data_type": {"enum": ["uint8", "uint16", "float32", "float64"]},
    "layout": {"enum": ["HW", "HWC", "CHW", "NCHW"]},
    "interpolation": {"enum": ["NEAREST", "BILINEAR", "BICUBIC"]},
    "rectangle": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"$ref": "#/$defs/positive_integer"}, "height": {"$ref": "#/$defs/positive_integer"}}
    },
    "prerequisites": {
      "type": "object", "additionalProperties": false,
      "required": ["required_inspection_status", "required_validation_outcome", "accepted_rgb_formats", "accepted_height_formats", "accepted_rgb_channels", "accepted_rgb_bit_depths", "accepted_height_storage_types"],
      "properties": {
        "required_inspection_status": {"const": "READY"},
        "required_validation_outcome": {"const": "VALIDATION_PASSED"},
        "accepted_rgb_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PNG", "JPEG", "BMP", "TIFF"]}},
        "accepted_height_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PNG", "TIFF", "NPY"]}},
        "accepted_rgb_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [1, 3, 4]}},
        "accepted_rgb_bit_depths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [8, 16]}},
        "accepted_height_storage_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["uint8", "uint16", "float32", "float64"]}}
      }
    },
    "normalization_parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "means": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "standard_deviations": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "scaling_parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "physical_unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "scale_source": {"type": "string", "minLength": 1, "maxLength": 256},
        "offset_source": {"type": "string", "minLength": 1, "maxLength": 256},
        "minimum": {"type": "number"}, "maximum": {"type": "number"},
        "mean": {"type": "number"}, "standard_deviation": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "rgb_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["roi_mode", "roi_rectangle", "resize_mode", "target_width", "target_height", "output_channels", "output_data_type", "output_layout", "normalization_mode", "normalization_parameters", "preserve_aspect_ratio", "interpolation_mode"],
      "properties": {
        "roi_mode": {"$ref": "#/$defs/roi_mode"}, "roi_rectangle": {"$ref": "#/$defs/rectangle"},
        "resize_mode": {"$ref": "#/$defs/resize_mode"}, "target_width": {"$ref": "#/$defs/nullable_positive_integer"}, "target_height": {"$ref": "#/$defs/nullable_positive_integer"},
        "output_channels": {"type": "integer", "enum": [1, 3, 4]}, "output_data_type": {"$ref": "#/$defs/data_type"}, "output_layout": {"$ref": "#/$defs/layout"},
        "normalization_mode": {"enum": ["NONE", "UNIT_RANGE", "MEAN_STD"]}, "normalization_parameters": {"$ref": "#/$defs/normalization_parameters"},
        "preserve_aspect_ratio": {"type": "boolean"}, "interpolation_mode": {"$ref": "#/$defs/interpolation"}
      }
    },
    "height_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["roi_mode", "roi_rectangle", "resize_mode", "target_width", "target_height", "output_channels", "output_data_type", "output_layout", "scaling_mode", "scaling_parameters", "invalid_value_handling", "requires_validity_mask_input", "replacement_value", "interpolation_mode"],
      "properties": {
        "roi_mode": {"$ref": "#/$defs/roi_mode"}, "roi_rectangle": {"$ref": "#/$defs/rectangle"},
        "resize_mode": {"$ref": "#/$defs/resize_mode"}, "target_width": {"$ref": "#/$defs/nullable_positive_integer"}, "target_height": {"$ref": "#/$defs/nullable_positive_integer"},
        "output_channels": {"type": "integer", "const": 1}, "output_data_type": {"$ref": "#/$defs/data_type"}, "output_layout": {"$ref": "#/$defs/layout"},
        "scaling_mode": {"enum": ["NONE", "DECLARED_PHYSICAL_SCALE", "MIN_MAX", "STANDARD_SCORE"]}, "scaling_parameters": {"$ref": "#/$defs/scaling_parameters"},
        "invalid_value_handling": {"enum": ["REJECT", "MASK", "REPLACE_WITH_CONSTANT", "PRESERVE_NAN"]},
        "requires_validity_mask_input": {"type": "boolean"}, "replacement_value": {"type": ["number", "null"]},
        "interpolation_mode": {"$ref": "#/$defs/interpolation"}
      }
    },
    "registration_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["registration_mode", "require_registration_evidence", "output_coordinate_reference", "dimension_relationship", "transform_source", "allow_synthetic_identity_transform"],
      "properties": {
        "registration_mode": {"enum": ["NOT_PERFORMED", "USE_DECLARED_TRANSFORM", "SYNTHETIC_IDENTITY_ONLY"]},
        "require_registration_evidence": {"type": "boolean"}, "output_coordinate_reference": {"enum": ["RGB", "HEIGHT", "SHARED_SYNTHETIC"]},
        "dimension_relationship": {"enum": ["SAME_DIMENSIONS_REQUIRED", "DIFFERENT_DIMENSIONS_ALLOWED", "DECLARED_TRANSFORM_REQUIRED"]},
        "transform_source": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "allow_synthetic_identity_transform": {"type": "boolean"}
      }
    },
    "output_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["require_matching_output_dimensions", "include_validity_mask", "include_registration_mask", "include_safe_summary_statistics"],
      "properties": {"require_matching_output_dimensions": {"type": "boolean"}, "include_validity_mask": {"type": "boolean"}, "include_registration_mask": {"type": "boolean"}, "include_safe_summary_statistics": {"type": "boolean"}}
    },
    "safety_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["allow_mock_implementation", "allow_synthetic_input", "allow_real_input", "allow_uncalibrated_height"],
      "properties": {"allow_mock_implementation": {"type": "boolean"}, "allow_synthetic_input": {"type": "boolean"}, "allow_real_input": {"type": "boolean"}, "allow_uncalibrated_height": {"type": "boolean"}}
    }
  }
}
