{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi-for-pcb.local/contracts/inspection-validation-policy/1.0",
  "title": "PCB AOI Paired Inspection Validation Policy",
  "description": "Recipe-selectable technical rules for evaluating native RGB_RAW and HEIGHT_RAW artifacts. This policy does not define PCB quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "policy_id",
    "policy_version",
    "display_name",
    "description",
    "development_only",
    "allowed_rgb_formats",
    "allowed_height_formats",
    "allowed_rgb_channels",
    "allowed_rgb_bit_depths",
    "allowed_height_storage_types",
    "allowed_height_invalid_value_policies",
    "minimum_height_bit_depth",
    "require_single_channel_height",
    "require_explicit_height_invalid_value_policy",
    "minimum_width",
    "minimum_height",
    "maximum_width",
    "maximum_height",
    "dimension_relationship",
    "require_calibration_artifact",
    "require_validity_mask",
    "require_registration_evidence",
    "warning_as_blocking"
  ],
  "properties": {
    "contract_version": {
      "const": "pcb-aoi-inspection-validation-policy/1.0"
    },
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_version": {"$ref": "#/$defs/version"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "development_only": {"type": "boolean"},
    "allowed_rgb_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["PNG", "JPEG", "BMP", "TIFF"]}
    },
    "allowed_height_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["PNG", "TIFF", "NPY"]}
    },
    "allowed_rgb_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [1, 3, 4]}
    },
    "allowed_rgb_bit_depths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [8, 16]}
    },
    "allowed_height_storage_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["uint16", "int16", "uint32", "float32", "float64"]
      }
    },
    "allowed_height_invalid_value_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["NONE", "SENTINEL_VALUE", "VALIDITY_MASK", "NAN"]
      }
    },
    "minimum_height_bit_depth": {
      "type": "integer",
      "enum": [16, 32, 64]
    },
    "require_single_channel_height": {"type": "boolean"},
    "require_explicit_height_invalid_value_policy": {"type": "boolean"},
    "minimum_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "minimum_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "maximum_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "maximum_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "dimension_relationship": {
      "enum": [
        "SAME_DIMENSIONS_REQUIRED",
        "DIFFERENT_DIMENSIONS_ALLOWED",
        "REGISTERED_TRANSFORM_REQUIRED"
      ]
    },
    "require_calibration_artifact": {"type": "boolean"},
    "require_validity_mask": {"type": "boolean"},
    "require_registration_evidence": {"type": "boolean"},
    "warning_as_blocking": {"type": "boolean", "default": false}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    }
  },
  "x-semantic_rules": [
    "maximum_width must be greater than or equal to minimum_width",
    "maximum_height must be greater than or equal to minimum_height",
    "NAN invalid-value policy is valid only for float32 or float64 height storage",
    "VALIDITY_MASK invalid-value policy requires a validity-mask artifact",
    "REGISTERED_TRANSFORM_REQUIRED requires registration evidence",
    "format-specific parser support must be confirmed before policy activation"
  ]
}
