{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi-for-pcb.local/contracts/inspection-development-report/1.0",
  "title": "PCB AOI Inspection Development Report",
  "description": "Deterministic read-only report of persisted development evidence. It is not a production inspection certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "inspection_id", "development_only", "production_approved",
    "synthetic_evidence_present", "mock_inference_present", "inspection", "artifacts",
    "validation", "processing", "audit", "limitations"
  ],
  "properties": {
    "contract_version": {"const": "pcb-aoi-inspection-development-report/1.0"},
    "inspection_id": {"$ref": "#/$defs/uuid"},
    "development_only": {"const": true},
    "production_approved": {"const": false},
    "synthetic_evidence_present": {"type": "boolean"},
    "mock_inference_present": {"type": "boolean"},
    "inspection": {"$ref": "#/$defs/inspection"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "validation": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/validation"}]},
    "processing": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/processing"}]},
    "audit": {"type": "array", "items": {"$ref": "#/$defs/audit_item"}},
    "limitations": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  },
  "$defs": {
    "uuid": {
      "type": "string", "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "safe_json": {
      "oneOf": [
        {"type": ["string", "number", "boolean", "null"]},
        {"type": "array", "items": {"$ref": "#/$defs/safe_json"}},
        {"type": "object", "propertyNames": {"not": {"pattern": "(?i)(path|filename|root|manifest|traceback|stack|exception|sql|content|confidence)"}}, "additionalProperties": {"$ref": "#/$defs/safe_json"}}
      ]
    },
    "inspection": {
      "type": "object", "additionalProperties": false,
      "required": ["created_at", "board_id", "recipe_id", "recipe_version", "lot_id", "operator_id", "status", "error"],
      "properties": {
        "created_at": {"$ref": "#/$defs/timestamp"},
        "board_id": {"type": "string"}, "recipe_id": {"type": "string"}, "recipe_version": {"type": "string"},
        "lot_id": {"type": ["string", "null"]}, "operator_id": {"type": ["string", "null"]},
        "status": {"enum": ["RECEIVED", "VALIDATION_FAILED", "READY", "PROCESSING", "PASS", "FAIL", "UNCERTAIN", "ERROR"]},
        "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "sha256", "byte_size", "media_type", "created_at"],
      "properties": {
        "artifact_type": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 0}, "media_type": {"type": ["string", "null"]},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "validation_id", "validation_key", "result_sha256", "outcome", "policy", "validator_version", "started_at", "completed_at", "rgb_technical_summary", "height_technical_summary", "findings", "summary"],
      "properties": {
        "contract_version": {"type": "string"}, "validation_id": {"$ref": "#/$defs/uuid"},
        "validation_key": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/sha256"},
        "outcome": {"enum": ["VALIDATION_PASSED", "VALIDATION_FAILED", "VALIDATION_ERROR"]},
        "policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version"], "properties": {"policy_id": {"type": "string"}, "policy_version": {"type": "string"}}},
        "validator_version": {"type": "string"}, "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"},
        "rgb_technical_summary": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe_json"}},
        "height_technical_summary": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe_json"}},
        "findings": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe_json"}}},
        "summary": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe_json"}}
      }
    },
    "processing": {
      "type": "object", "additionalProperties": false,
      "required": ["processing_run_id", "validation_id", "processing_key", "lifecycle_status", "preprocessing_policy", "preprocessing_implementation", "inference_policy", "engine", "started_at", "completed_at", "final_decision", "error", "preprocessing", "inference", "synthetic_input", "mock_preprocessing", "mock_inference", "production_approved"],
      "properties": {
        "processing_run_id": {"$ref": "#/$defs/uuid"}, "validation_id": {"$ref": "#/$defs/uuid"},
        "processing_key": {"$ref": "#/$defs/sha256"}, "lifecycle_status": {"enum": ["STARTED", "COMPLETED", "ERROR"]},
        "preprocessing_policy": {"$ref": "#/$defs/string_map"}, "preprocessing_implementation": {"$ref": "#/$defs/string_map"},
        "inference_policy": {"$ref": "#/$defs/string_map"}, "engine": {"$ref": "#/$defs/string_map"},
        "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "final_decision": {"type": ["string", "null"], "enum": ["PASS", "FAIL", "UNCERTAIN", null]},
        "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}]},
        "preprocessing": {"oneOf": [{"type": "null"}, {"type": "object", "propertyNames": {"not": {"pattern": "(?i)(path|filename|confidence)"}}, "additionalProperties": {"$ref": "#/$defs/safe_json"}}]},
        "inference": {"oneOf": [{"type": "null"}, {"type": "object", "propertyNames": {"not": {"pattern": "(?i)(path|filename|confidence)"}}, "additionalProperties": {"$ref": "#/$defs/safe_json"}}]},
        "synthetic_input": {"type": "boolean"}, "mock_preprocessing": {"type": "boolean"}, "mock_inference": {"type": "boolean"}, "production_approved": {"const": false}
      }
    },
    "string_map": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string"}},
    "audit_item": {
      "type": "object", "additionalProperties": false,
      "required": ["audit_event_id", "inspection_id", "action", "created_at", "actor_id", "request_id", "details", "details_redacted", "development_only", "mock_result", "production_approved"],
      "properties": {
        "audit_event_id": {"$ref": "#/$defs/uuid"}, "inspection_id": {"$ref": "#/$defs/uuid"},
        "action": {"type": "string"}, "created_at": {"$ref": "#/$defs/timestamp"},
        "actor_id": {"type": ["string", "null"]}, "request_id": {"type": ["string", "null"]},
        "details": {"type": "object", "additionalProperties": {"$ref": "#/$defs/safe_json"}},
        "details_redacted": {"type": "boolean"}, "development_only": {"type": ["boolean", "null"]},
        "mock_result": {"type": ["string", "null"], "enum": ["PASS", "FAIL", "UNCERTAIN", null]},
        "production_approved": {"type": ["boolean", "null"]}
      }
    }
  }
}
