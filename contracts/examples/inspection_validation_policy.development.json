{
  "contract_version": "pcb-aoi-inspection-validation-policy/1.0",
  "policy_id": "development-native-rgb-height",
  "policy_version": "1.0",
  "display_name": "Development native RGB and height policy",
  "description": "Development-only example for technical contract testing. It is not approved for production acceptance.",
  "development_only": true,
  "allowed_rgb_formats": ["PNG", "JPEG", "BMP", "TIFF"],
  "allowed_height_formats": ["PNG", "TIFF", "NPY"],
  "allowed_rgb_channels": [1, 3, 4],
  "allowed_rgb_bit_depths": [8, 16],
  "allowed_height_storage_types": [
    "uint16",
    "int16",
    "uint32",
    "float32",
    "float64"
  ],
  "allowed_height_invalid_value_policies": [
    "NONE",
    "SENTINEL_VALUE",
    "VALIDITY_MASK",
    "NAN"
  ],
  "minimum_height_bit_depth": 16,
  "require_single_channel_height": true,
  "require_explicit_height_invalid_value_policy": true,
  "minimum_width": 1,
  "minimum_height": 1,
  "maximum_width": 16384,
  "maximum_height": 16384,
  "dimension_relationship": "SAME_DIMENSIONS_REQUIRED",
  "require_calibration_artifact": false,
  "require_validity_mask": false,
  "require_registration_evidence": false,
  "warning_as_blocking": false
}
