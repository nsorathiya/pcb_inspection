{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi-for-pcb.local/contracts/pcb-aoi-sample/1.0",
  "title": "PCB AOI Paired 2D/3D Sample Metadata",
  "description": "Metadata for one independently identifiable physical PCB inspection instance with a strict RGB and native height/depth pair.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sample_id",
    "board_id",
    "recipe_id",
    "recipe_version",
    "ground_truth",
    "production",
    "capture",
    "files",
    "rgb",
    "height_3d",
    "registration",
    "integrity",
    "provenance"
  ],
  "properties": {
    "contract_version": {
      "const": "pcb-aoi-dataset/1.0"
    },
    "sample_id": {
      "$ref": "#/$defs/identifier"
    },
    "board_id": {
      "$ref": "#/$defs/identifier"
    },
    "panel_id": {
      "$ref": "#/$defs/identifier"
    },
    "component_ref": {
      "$ref": "#/$defs/identifier"
    },
    "inspection_region_id": {
      "$ref": "#/$defs/identifier"
    },
    "recipe_id": {
      "$ref": "#/$defs/identifier"
    },
    "recipe_version": {
      "$ref": "#/$defs/identifier"
    },
    "ground_truth": {
      "$ref": "#/$defs/ground_truth"
    },
    "production": {
      "$ref": "#/$defs/production"
    },
    "capture": {
      "$ref": "#/$defs/capture"
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "rgb": {
      "$ref": "#/$defs/rgb"
    },
    "height_3d": {
      "$ref": "#/$defs/height_3d"
    },
    "registration": {
      "$ref": "#/$defs/registration"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "height_3d": {
            "properties": {
              "no_data_policy": {
                "const": "validity_mask"
              }
            },
            "required": [
              "no_data_policy"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "required": [
              "validity_mask_file"
            ]
          },
          "integrity": {
            "required": [
              "validity_mask_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "height_3d": {
            "properties": {
              "no_data_policy": {
                "const": "nan"
              }
            },
            "required": [
              "no_data_policy"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "height_3d": {
            "properties": {
              "storage_data_type": {
                "enum": [
                  "float32",
                  "float64"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "defect_type",
        "taxonomy_version",
        "label_source",
        "review_status"
      ],
      "properties": {
        "label": {
          "enum": [
            "OK",
            "NOK"
          ]
        },
        "defect_type": {
          "oneOf": [
            {
              "$ref": "https://aoi-for-pcb.local/contracts/defect-taxonomy/1.0#/$defs/supported_defect_type"
            },
            {
              "type": "null"
            }
          ]
        },
        "taxonomy_version": {
          "const": "pcb-aoi-defects/1.0"
        },
        "label_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "in_review",
            "approved",
            "rejected"
          ]
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "review_notes": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "OK"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "defect_type": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "NOK"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "defect_type": {
                "$ref": "https://aoi-for-pcb.local/contracts/defect-taxonomy/1.0#/$defs/supported_defect_type"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "review_status": {
                "const": "approved"
              }
            },
            "required": [
              "review_status"
            ]
          },
          "then": {
            "required": [
              "reviewed_by",
              "reviewed_at"
            ]
          }
        }
      ]
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lot_id",
        "capture_session_id",
        "production_date",
        "station_id"
      ],
      "properties": {
        "lot_id": {
          "$ref": "#/$defs/identifier"
        },
        "batch_id": {
          "$ref": "#/$defs/identifier"
        },
        "capture_session_id": {
          "$ref": "#/$defs/identifier"
        },
        "production_date": {
          "type": "string",
          "format": "date"
        },
        "station_id": {
          "$ref": "#/$defs/identifier"
        },
        "machine_id": {
          "$ref": "#/$defs/identifier"
        },
        "sequential_group_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "camera_2d_id",
        "sensor_3d_id"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "camera_2d_id": {
          "$ref": "#/$defs/identifier"
        },
        "sensor_3d_id": {
          "$ref": "#/$defs/identifier"
        },
        "lighting_profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "exposure_time_us": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "gain_db": {
              "type": "number"
            },
            "aperture_f_number": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rgb_file",
        "height_file"
      ],
      "properties": {
        "rgb_file": {
          "$ref": "#/$defs/relative_path"
        },
        "height_file": {
          "$ref": "#/$defs/relative_path"
        },
        "validity_mask_file": {
          "$ref": "#/$defs/relative_path"
        },
        "calibration_file": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "rgb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "channels",
        "color_space",
        "bit_depth"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "color_space": {
          "enum": [
            "GRAY",
            "RGB",
            "BAYER_RGGB",
            "BAYER_BGGR",
            "BAYER_GRBG",
            "BAYER_GBRG"
          ]
        },
        "bit_depth": {
          "type": "integer",
          "enum": [
            8,
            10,
            12,
            16
          ]
        }
      }
    },
    "height_3d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "width",
        "height",
        "storage_format",
        "storage_data_type",
        "physical_value_type",
        "z_unit",
        "z_scale",
        "z_offset",
        "xy_unit",
        "x_scale",
        "y_scale",
        "no_data_policy"
      ],
      "properties": {
        "representation": {
          "enum": [
            "height_map",
            "depth_map"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "storage_format": {
          "enum": [
            "tiff",
            "npy",
            "hdf5",
            "exr"
          ]
        },
        "storage_data_type": {
          "enum": [
            "uint16",
            "int16",
            "uint32",
            "int32",
            "float32",
            "float64"
          ]
        },
        "physical_value_type": {
          "enum": [
            "height",
            "depth"
          ]
        },
        "z_unit": {
          "enum": [
            "um",
            "mm",
            "m"
          ]
        },
        "z_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "z_offset": {
          "type": "number"
        },
        "xy_unit": {
          "enum": [
            "um",
            "mm",
            "m"
          ]
        },
        "x_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "y_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "invalid_value": {
          "type": "number"
        },
        "no_data_policy": {
          "enum": [
            "none",
            "sentinel_value",
            "validity_mask",
            "nan"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "no_data_policy": {
                "const": "sentinel_value"
              }
            },
            "required": [
              "no_data_policy"
            ]
          },
          "then": {
            "required": [
              "invalid_value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "height_map"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "properties": {
              "physical_value_type": {
                "const": "height"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "representation": {
                "const": "depth_map"
              }
            },
            "required": [
              "representation"
            ]
          },
          "then": {
            "properties": {
              "physical_value_type": {
                "const": "depth"
              }
            }
          }
        }
      ]
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_status",
        "registration_method",
        "calibration_version",
        "coordinate_system"
      ],
      "properties": {
        "registration_status": {
          "enum": [
            "aligned",
            "requires_transform",
            "unverified"
          ]
        },
        "registration_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "transform_reference": {
          "$ref": "#/$defs/relative_path"
        },
        "calibration_version": {
          "$ref": "#/$defs/identifier"
        },
        "coordinate_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "registration_status": {
                "const": "requires_transform"
              }
            },
            "required": [
              "registration_status"
            ]
          },
          "then": {
            "required": [
              "transform_reference"
            ]
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rgb_sha256",
        "height_sha256"
      ],
      "properties": {
        "rgb_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "height_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "validity_mask_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "imported_at",
        "is_synthetic"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_export_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "imported_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "is_synthetic": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      }
    }
  }
}
