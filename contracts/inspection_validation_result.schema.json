{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi-for-pcb.local/contracts/inspection-validation-result/1.0",
  "title": "PCB AOI Paired Inspection Technical Validation Result",
  "description": "Result of technical RGB_RAW/HEIGHT_RAW suitability validation. Outcomes are not PCB quality classifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "validation_id",
    "inspection_id",
    "validation_policy_id",
    "validation_policy_version",
    "outcome",
    "started_at",
    "completed_at",
    "validator_version",
    "rgb_artifact",
    "height_artifact",
    "findings",
    "summary"
  ],
  "properties": {
    "contract_version": {
      "const": "pcb-aoi-inspection-validation/1.0"
    },
    "validation_id": {"$ref": "#/$defs/canonical_uuid"},
    "inspection_id": {"$ref": "#/$defs/canonical_uuid"},
    "validation_policy_id": {"$ref": "#/$defs/identifier"},
    "validation_policy_version": {"$ref": "#/$defs/version"},
    "outcome": {
      "enum": [
        "VALIDATION_PASSED",
        "VALIDATION_FAILED",
        "VALIDATION_ERROR"
      ]
    },
    "started_at": {"$ref": "#/$defs/timezone_timestamp"},
    "completed_at": {"$ref": "#/$defs/timezone_timestamp"},
    "validator_version": {"$ref": "#/$defs/version"},
    "rgb_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact_summary"},
        {
          "properties": {"artifact_type": {"const": "RGB_RAW"}}
        }
      ]
    },
    "height_artifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact_summary"},
        {
          "properties": {"artifact_type": {"const": "HEIGHT_RAW"}}
        }
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "https://aoi-for-pcb.local/contracts/inspection-validation-findings/1.0#/$defs/finding"
      }
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"outcome": {"const": "VALIDATION_PASSED"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "rgb_artifact": {
            "properties": {
              "readability_status": {"const": "READABLE"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "byte_size": {"type": "integer", "minimum": 0},
              "detected_format": {"type": "string"},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "channels": {"type": "integer", "minimum": 1},
              "bit_depth": {"type": "integer", "minimum": 1}
            }
          },
          "height_artifact": {
            "properties": {
              "readability_status": {"const": "READABLE"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "byte_size": {"type": "integer", "minimum": 0},
              "detected_format": {"type": "string"},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1},
              "channels": {"const": 1},
              "bit_depth": {"type": "integer", "minimum": 1},
              "storage_data_type": {"type": "string"}
            }
          },
          "findings": {
            "allOf": [
              {
                "not": {
                  "contains": {
                    "properties": {
                      "blocking": {"const": true}
                    },
                    "required": ["blocking"]
                  }
                }
              },
              {
                "not": {
                  "contains": {
                    "properties": {
                      "code": {
                        "enum": [
                          "RGB_RAW_MISSING",
                          "HEIGHT_RAW_MISSING",
                          "INCOMPLETE_RAW_PAIR",
                          "ARTIFACT_FILE_MISSING",
                          "ARTIFACT_SIZE_MISMATCH",
                          "ARTIFACT_SHA256_MISMATCH"
                        ]
                      }
                    },
                    "required": ["code"]
                  }
                }
              }
            ]
          },
          "summary": {
            "properties": {"technically_ready": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "VALIDATION_FAILED"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {"blocking": {"const": true}},
              "required": ["blocking"]
            },
            "minContains": 1
          },
          "summary": {
            "properties": {"technically_ready": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"outcome": {"const": "VALIDATION_ERROR"}},
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "code": {"const": "VALIDATOR_INTERNAL_ERROR"},
                "severity": {"const": "ERROR"},
                "category": {"const": "INTERNAL"},
                "blocking": {"const": true}
              },
              "required": ["code", "severity", "category", "blocking"]
            },
            "minContains": 1
          },
          "summary": {
            "properties": {"technically_ready": {"const": false}}
          }
        }
      }
    }
  ],
  "$defs": {
    "canonical_uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "timezone_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullable_positive_integer": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "null"}
      ]
    },
    "artifact_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "sha256",
        "byte_size",
        "declared_media_type",
        "detected_format",
        "width",
        "height",
        "channels",
        "bit_depth",
        "storage_data_type",
        "readability_status"
      ],
      "properties": {
        "artifact_type": {"enum": ["RGB_RAW", "HEIGHT_RAW"]},
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "byte_size": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "declared_media_type": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "detected_format": {
          "oneOf": [
            {"enum": ["PNG", "JPEG", "BMP", "TIFF", "NPY"]},
            {"type": "null"}
          ]
        },
        "width": {"$ref": "#/$defs/nullable_positive_integer"},
        "height": {"$ref": "#/$defs/nullable_positive_integer"},
        "channels": {"$ref": "#/$defs/nullable_positive_integer"},
        "bit_depth": {"$ref": "#/$defs/nullable_positive_integer"},
        "storage_data_type": {
          "oneOf": [
            {
              "enum": [
                "uint8",
                "uint16",
                "int16",
                "uint32",
                "float32",
                "float64"
              ]
            },
            {"type": "null"}
          ]
        },
        "readability_status": {
          "enum": [
            "READABLE",
            "MISSING",
            "UNREADABLE",
            "INTEGRITY_FAILED",
            "UNINSPECTED"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_count",
        "info_count",
        "warning_count",
        "error_count",
        "blocking_count",
        "technically_ready",
        "synthetic_example"
      ],
      "properties": {
        "finding_count": {"type": "integer", "minimum": 0},
        "info_count": {"type": "integer", "minimum": 0},
        "warning_count": {"type": "integer", "minimum": 0},
        "error_count": {"type": "integer", "minimum": 0},
        "blocking_count": {"type": "integer", "minimum": 0},
        "technically_ready": {"type": "boolean"},
        "synthetic_example": {"type": "boolean"}
      }
    }
  },
  "x-semantic_rules": [
    "completed_at must not precede started_at",
    "summary counts must equal the findings array",
    "findings must be sorted by catalogue order, artifact type, field, then message",
    "a finding with blocking=true prevents VALIDATION_PASSED",
    "blocking non-internal findings produce VALIDATION_FAILED; unexpected internal failure produces VALIDATION_ERROR"
  ]
}
