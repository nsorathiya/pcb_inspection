{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi-for-pcb.local/contracts/inspection-preprocessing-result/1.0",
  "title": "PCB AOI Inspection Preprocessing Result",
  "description": "Path-free technical preprocessing result for separate RGB and height branches. Outcomes are not PCB quality classifications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "preprocessing_id", "inspection_id", "validation_id", "policy_id", "policy_version", "implementation_id", "implementation_version", "outcome", "started_at", "completed_at", "synthetic_input", "mock_implementation", "production_approved", "rgb_input", "height_input", "rgb_output", "height_output", "registration", "findings", "summary"],
  "properties": {
    "contract_version": {"const": "pcb-aoi-inspection-preprocessing/1.0"},
    "preprocessing_id": {"$ref": "#/$defs/canonical_uuid"}, "inspection_id": {"$ref": "#/$defs/canonical_uuid"}, "validation_id": {"$ref": "#/$defs/canonical_uuid"},
    "policy_id": {"$ref": "#/$defs/identifier"}, "policy_version": {"$ref": "#/$defs/version"},
    "implementation_id": {"$ref": "#/$defs/identifier"}, "implementation_version": {"$ref": "#/$defs/version"},
    "outcome": {"enum": ["PREPROCESSING_SUCCEEDED", "PREPROCESSING_FAILED", "PREPROCESSING_ERROR"]},
    "started_at": {"$ref": "#/$defs/timezone_timestamp"}, "completed_at": {"$ref": "#/$defs/timezone_timestamp"},
    "synthetic_input": {"type": "boolean"}, "mock_implementation": {"type": "boolean"}, "production_approved": {"type": "boolean"},
    "rgb_input": {"allOf": [{"$ref": "#/$defs/input_identity"}, {"properties": {"artifact_type": {"const": "RGB_RAW"}}}]},
    "height_input": {"allOf": [{"$ref": "#/$defs/input_identity"}, {"properties": {"artifact_type": {"const": "HEIGHT_RAW"}}}]},
    "validity_mask_input": {"allOf": [{"$ref": "#/$defs/input_identity"}, {"properties": {"artifact_type": {"const": "VALIDITY_MASK"}}}]},
    "calibration_input": {"allOf": [{"$ref": "#/$defs/input_identity"}, {"properties": {"artifact_type": {"const": "CALIBRATION"}}}]},
    "rgb_output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/rgb_output"}]},
    "height_output": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/height_output"}]},
    "registration": {"$ref": "#/$defs/registration_summary"},
    "findings": {"type": "array", "items": {"$ref": "https://aoi-for-pcb.local/contracts/inspection-preprocessing-findings/1.0#/$defs/finding"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "PREPROCESSING_SUCCEEDED"}}}, "then": {"properties": {"rgb_output": {"$ref": "#/$defs/rgb_output"}, "height_output": {"$ref": "#/$defs/height_output"}, "findings": {"not": {"contains": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]}}}}}},
    {"if": {"properties": {"outcome": {"const": "PREPROCESSING_FAILED"}}}, "then": {"properties": {"findings": {"contains": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]}}}}},
    {"if": {"properties": {"outcome": {"const": "PREPROCESSING_ERROR"}}}, "then": {"properties": {"findings": {"contains": {"properties": {"code": {"const": "PREPROCESSING_INTERNAL_ERROR"}, "blocking": {"const": true}}, "required": ["code", "blocking"]}}}}}
  ],
  "$defs": {
    "canonical_uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "timezone_timestamp": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_type": {"enum": ["uint8", "uint16", "float32", "float64"]},
    "layout": {"enum": ["HW", "HWC", "CHW", "NCHW"]},
    "input_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "sha256", "byte_size", "detected_format", "width", "height", "channels", "bit_depth", "storage_data_type"],
      "properties": {
        "artifact_type": {"enum": ["RGB_RAW", "HEIGHT_RAW", "VALIDITY_MASK", "CALIBRATION"]}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_size": {"type": "integer", "minimum": 0},
        "detected_format": {"type": "string", "minLength": 1, "maxLength": 32}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "channels": {"type": "integer", "minimum": 1}, "bit_depth": {"type": "integer", "minimum": 1}, "storage_data_type": {"type": ["string", "null"], "enum": ["uint8", "uint16", "float32", "float64", null]}
      }
    },
    "roi": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "x", "y", "width", "height"],
      "properties": {"mode": {"enum": ["FULL_FRAME", "STATIC_RECTANGLE", "RECIPE_DEFINED"]}, "x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "safe_statistics": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum", "maximum", "mean", "standard_deviation", "finite_value_count", "nonfinite_value_count", "element_count"],
      "properties": {"minimum": {"type": ["number", "null"]}, "maximum": {"type": ["number", "null"]}, "mean": {"type": ["number", "null"]}, "standard_deviation": {"type": ["number", "null"], "minimum": 0}, "finite_value_count": {"type": "integer", "minimum": 0}, "nonfinite_value_count": {"type": "integer", "minimum": 0}, "element_count": {"type": "integer", "minimum": 0}}
    },
    "buffer_summary": {
      "type": "object",
      "required": ["shape", "layout", "data_type", "channel_count", "width", "height", "byte_order", "contiguous", "finite_values_verified", "source_artifact_sha256"],
      "properties": {
        "shape": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "integer", "minimum": 1}}, "layout": {"$ref": "#/$defs/layout"}, "data_type": {"$ref": "#/$defs/data_type"},
        "channel_count": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "byte_order": {"enum": ["NOT_APPLICABLE", "LITTLE_ENDIAN", "BIG_ENDIAN", "NATIVE"]}, "contiguous": {"type": "boolean"}, "finite_values_verified": {"type": "boolean"}, "source_artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rgb_output": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/buffer_summary"}, {"type": "object", "required": ["normalization_mode", "roi"], "properties": {"normalization_mode": {"enum": ["NONE", "UNIT_RANGE", "MEAN_STD"]}, "roi": {"$ref": "#/$defs/roi"}, "safe_statistics": {"$ref": "#/$defs/safe_statistics"}}}]
    },
    "height_output": {
      "type": "object", "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/buffer_summary"}, {"type": "object", "required": ["scaling_mode", "invalid_value_handling", "physical_unit", "physical_scale_applied", "roi"], "properties": {"scaling_mode": {"enum": ["NONE", "DECLARED_PHYSICAL_SCALE", "MIN_MAX", "STANDARD_SCORE"]}, "invalid_value_handling": {"enum": ["REJECT", "MASK", "REPLACE_WITH_CONSTANT", "PRESERVE_NAN"]}, "physical_unit": {"type": ["string", "null"], "minLength": 1}, "physical_scale_applied": {"type": "boolean"}, "roi": {"$ref": "#/$defs/roi"}, "safe_statistics": {"$ref": "#/$defs/safe_statistics"}}}]
    },
    "registration_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["registration_mode", "registration_status", "transform_applied", "transform_reference", "synthetic_identity", "output_coordinate_reference", "registration_warning"],
      "properties": {"registration_mode": {"enum": ["NOT_PERFORMED", "USE_DECLARED_TRANSFORM", "SYNTHETIC_IDENTITY_ONLY"]}, "registration_status": {"enum": ["NOT_PERFORMED", "APPLIED", "SYNTHETIC_IDENTITY", "FAILED"]}, "transform_applied": {"type": "boolean"}, "transform_reference": {"type": ["string", "null"], "minLength": 1}, "synthetic_identity": {"type": "boolean"}, "output_coordinate_reference": {"enum": ["RGB", "HEIGHT", "SHARED_SYNTHETIC"]}, "registration_warning": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total_findings", "blocking_findings", "warnings", "errors"],
      "properties": {"total_findings": {"type": "integer", "minimum": 0}, "blocking_findings": {"type": "integer", "minimum": 0}, "warnings": {"type": "integer", "minimum": 0}, "errors": {"type": "integer", "minimum": 0}}
    }
  }
}
